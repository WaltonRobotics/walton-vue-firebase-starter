rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Avatars are stored at avatars/<uid>/<filename> (see ProfileView.vue).
    // Anyone can view an avatar (they're just profile photos), but only the
    // owner can upload to their own folder, and only small image files.
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
