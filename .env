# Placeholder Firebase config for local development against the emulators
# (see `npm run emulators`). These values are NOT secret and don't need to
# change — the emulators don't check them. This file is committed on purpose.
#
# Deploying to the team's real project? See DEPLOY.md — you'll add a
# `.env.production.local` with real values there, which Vite uses instead of
# this file for production builds only (`npm run dev` always uses these).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-walton-starter.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-walton-starter
VITE_FIREBASE_STORAGE_BUCKET=demo-walton-starter.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
