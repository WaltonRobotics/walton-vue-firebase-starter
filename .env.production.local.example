# You only need this file when DEPLOYING to the team's real Firebase project —
# day-to-day development uses the local emulators and the placeholder values in
# `.env`, so most of the time you can ignore this file entirely.
# See DEPLOY.md for the full walkthrough.
#
# Copy this file to `.env.production.local` (git-ignored — never commit real
# keys) and fill in the values your mentor gives you, or that you find at:
# Firebase console > Project settings > General > Your apps > SDK setup and configuration
#
# Named `.env.production.local` (not `.env.local`) on purpose: Vite only loads
# it for `npm run build` (a "production" mode build), never for `npm run dev`.
# That means `npm run dev` always uses the emulators, even after you've set
# this up for a deploy.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
